+        bl, br = self.xyz[ii + 1, jj], self.xyz[ii + 1, jj + 1]
+        top = tl + (tr - tl) * dj[:, None]
+        bottom = bl + (br - bl) * dj[:, None]
+        result[valid] = top + (bottom - top) * di[:, None]
+        return result, valid

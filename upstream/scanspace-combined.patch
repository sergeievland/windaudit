+            weights = np.hypot(di, dj) * (1 + medial_weight / np.maximum(dt[self.ii[dst], self.jj[dst]], 1))
+            if random_seed is not None:
+                weights = weights * np.exp(rng.uniform(-2, 2, len(weights)))
